# Safe to expose in the browser. Find both under Supabase > Connect > App Frameworks.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional local-only quick-access panel. It is always disabled in production.
LOCAL_PREVIEW_MODE=false
LOCAL_PREVIEW_FIXTURE_PATH=.local-preview/fixture.json
